# Copy to .env and adjust:  cp .env.example .env
# `.env` is gitignored; this file is the documented reference and is committed.
# Every variable is optional: Docker Compose and the Python code fall back to
# these values. More background: docs/infrastructure.md
#
# CPU or GPU is not set here: use `make up` (CPU) or `make up-gpu` (NVIDIA).
#
# Keep comments on their own lines: an inline "# comment" would become part of
# the value.


# ------------------------------------------------------------------- R libraries
# The folders with installed R packages to index (`make sync`). Written by `make init`
# (Windows: .\init.ps1), which asks; edit it here or run init again to change it.
# Separated like R's R_LIBS: ":" on Linux and macOS, ";" on Windows. Not set = every
# library of your R (.libPaths()). Example:
# RDOCS_LIBRARIES="/usr/lib/R/library:/home/<you>/R/x86_64-pc-linux-gnu-library/4.3"


# --------------------------------------------------------------------- logging
# How much the Python code logs (to stderr; for the API: make logs): DEBUG, INFO,
# WARNING or ERROR. INFO: one line per API request and per synced package. DEBUG adds
# one line per stored batch (chunks embedded vs reused, time) and the health checks.
LOG_LEVEL=INFO


# ---------------------------------------------------------------------- models
#
# qwen3:1.7b (~1.4 GB) is the default because it works on the most machines:
# it fits beside the embedding model on a 6 GB GPU and loads on CPU with ~3 GB
# given to Docker. Measured on a GTX 1660 Ti: ~97 tokens/s once warm, giving a
# one-sentence answer in 0.2 s. qwen3:4b (~2.5 GB) failed there under a ~2.8 GB
# WSL memory cap.
#
#   6 GB VRAM or CPU with ~3 GB for Docker -> qwen3:1.7b  (default)
#   8-12 GB VRAM, or more RAM for Docker    -> qwen3:4b or qwen3:8b
LLM_MODEL=qwen3:1.7b

# 768-dimensional. If you change this you must also recreate the Qdrant
# collection, since vector size is fixed at creation time.
EMBEDDING_MODEL=nomic-embed-text


# ---------------------------------------------------------------------- ollama
# How long a model stays in memory after its last request (Ollama default: 5m).
# Long values avoid reload latency; short values free memory sooner.
OLLAMA_KEEP_ALIVE=30m

# Models held in memory at once (Ollama default: automatic, 3 per GPU). 2 lets
# the generation and embedding models stay loaded together and no more.
OLLAMA_MAX_LOADED_MODELS=2


# ---------------------------------------------------------------------- qdrant
# Empty = authentication disabled, which is reasonable while the port is bound
# to 127.0.0.1 only. Set a value to require an api-key header; do this if you
# ever publish Qdrant beyond localhost or run on a shared machine.
QDRANT_API_KEY=


# ------------------------------------------------------------------ host ports
# Published on 127.0.0.1 only. Change if something else already uses them.
QDRANT_HOST_PORT=6333
OLLAMA_HOST_PORT=11434
# The rag HTTP API (interactive docs at http://localhost:8000/docs).
RAG_HOST_PORT=8000
